# Gemini makes every AI decision (intent, mission plans, matching, what to publish, personality).
# Without it the app runs a deterministic simulator and labels every AI line "simulated".
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Deepgram: speech-to-text and text-to-speech in the browser (server-side key, short-lived grants).
# Without it, voice falls back to the browser's speech APIs or a typed "simulated voice" answer.
DEEPGRAM_API_KEY=

# Signs session cookies and voice-agent tokens. Required in production.
SESSION_SECRET=change-me-to-a-long-random-string

# Personality inference: analyze the human's own words once this many tokens are collected (max 300k).
PERSONALITY_MIN_TOKENS=200000

# Optional Pipecat real-time voice bot (voice-agent/). Leave empty to hide the Pipecat panel.
NEXT_PUBLIC_PIPECAT_URL=
VEXOWORLD_URL=http://localhost:3000

# Storage backend: "local" (JSON file in .data, default) or "supabase" (see README, supabase/migrations).
VEXOWORLD_DATA_BACKEND=local
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Bypasses RLS; never expose to the browser.
SUPABASE_SECRET_KEY=

# Lets a demo session wipe the whole database from Settings. Leave unset in production.
VEXOWORLD_ALLOW_RESET=

# Vexo band capture (band-capture/ script): which band this app's user owns, and the shared HMAC secret
# (>= 32 chars) that signs requests from the capture script to /api/band/*. Both sides must use the same value.
VEXO_BAND_NUMBER=47
VEXOWORLD_BAND_SECRET=
# Deepgram model used by the capture script for transcription.
DEEPGRAM_MODEL=nova-3
